<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="knotbook">
  <schema id="dev.knotbook.Knotbook" path="/dev/knotbook/Knotbook/">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Window height</summary>
    </key>
    <key name="window-is-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-vault" type="s">
      <default>""</default>
      <summary>Vault opened last</summary>
      <description>URI of the vault folder to open on start, empty for none.</description>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"default"</default>
      <summary>Color scheme</summary>
      <description>Whether the app follows the system style or is always light or dark.</description>
    </key>
    <key name="notes-sort" type="s">
      <choices>
        <choice value="recent"/>
        <choice value="name"/>
        <choice value="project"/>
      </choices>
      <default>"recent"</default>
      <summary>Order of the notes</summary>
      <description>Whether the notes page lists the notes by when they were last edited, by name or by project.</description>
    </key>
  </schema>
</schemalist>
