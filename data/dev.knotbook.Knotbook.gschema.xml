<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="knotbook">
  <schema id="dev.knotbook.Knotbook" path="/dev/knotbook/Knotbook/">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Window height</summary>
    </key>
    <key name="window-is-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="last-vault" type="s">
      <default>""</default>
      <summary>Vault opened last</summary>
      <description>URI of the vault folder to open on start, empty for none.</description>
    </key>
  </schema>
</schemalist>
