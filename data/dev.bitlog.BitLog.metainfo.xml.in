<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.bitlog.BitLog</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>BitLog</name>
  <summary>Keep a daily log of your work</summary>
  <description>
    <p>
      BitLog is a daily dev log. It splits the working day into 15-minute
      blocks and assigns them to projects – roughly and in hindsight, without
      a stopwatch. Blocks can carry notes in Markdown.
    </p>
    <p>
      All data lives in plain text files in an ordinary folder, which you can
      sync with Syncthing, Nextcloud, Git or anything else. There is no server.
    </p>
  </description>
  <developer id="dev.bitlog">
    <name translate="no">coffeebowl</name>
  </developer>
  <launchable type="desktop-id">dev.bitlog.BitLog.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#ddd3f5</color>
    <color type="primary" scheme_preference="dark">#4f3a87</color>
  </branding>
  <content_rating type="oars-1.1"/>
</component>
