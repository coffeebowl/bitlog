{
  "id": "dev.bitlog.BitLog",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "bitlog-gtk",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/bitlog/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "modules": [
    {
      "name": "bitlog",
      "buildsystem": "meson",
      "config-opts": ["--buildtype=release"],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [".flatpak-builder", "_build", "_dist", "_flatpak", "_install", "_repo", "target"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
