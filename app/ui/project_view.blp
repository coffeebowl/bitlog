using Gtk 4.0;
using Adw 1;

template $BitLogProjectView: Adw.NavigationPage {
  tag: "project";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [end]
      Button edit_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Edit Project");
        action-name: "projects.edit";
      }
    }

    [top]
    Adw.InlineViewSwitcher switcher {
      stack: view_stack;
      halign: center;
      margin-bottom: 6;
      visible: false;
    }

    content: Adw.ViewStack view_stack {
      Adw.ViewStackPage {
        name: "project";
        title: _("Project");

        child: ScrolledWindow scrolled {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 900;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Box {
              orientation: vertical;
              // The note cards expand; the sections stay together at the top.
              valign: start;
              spacing: 24;

              Adw.PreferencesGroup {
                title: _("Time");

                Adw.ActionRow total_row {
                  title: _("Total");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow recent_row {
                  title: _("Recently");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow span_row {
                  title: _("First and Last Day");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow longest_row {
                  title: _("Longest Block");

                  [suffix]
                  Image {
                    icon-name: "go-next-symbolic";
                  }

                  styles [
                    "property",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Activity");
                description: _("Time spent per day in the last 30 days");

                $BitLogHeatmap heatmap {
                  cell-size: 18;
                  single-row: true;
                  halign: start;
                }
              }

              Adw.PreferencesGroup {
                title: _("Notes");

                // Without notes, the row in their place adds one.
                header-suffix: Button new_note_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New Note");
                  action-name: "notes.new";
                  valign: center;

                  styles [
                    "flat",
                  ]
                };

                Stack notes_stack {
                  vhomogeneous: false;

                  StackPage {
                    name: "list";

                    child: FlowBox notes_grid {
                      valign: start;
                      homogeneous: true;
                      selection-mode: none;
                      max-children-per-line: 8;
                      column-spacing: 12;
                      row-spacing: 18;
                    };
                  }

                  StackPage {
                    name: "empty";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ButtonRow empty_new_note_button {
                        title: _("_New Note");
                        use-underline: true;
                        start-icon-name: "list-add-symbolic";
                        action-name: "notes.new";
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }

                  StackPage {
                    name: "error";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ActionRow notes_error_row {
                        title: _("Cannot Read Notes");

                        [prefix]
                        Image {
                          icon-name: "dialog-error-symbolic";
                        }
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }
                }
              }

              Adw.PreferencesGroup {
                title: _("Files");

                header-suffix: Box {
                  valign: center;

                  Button {
                    icon-name: "folder-open-symbolic";
                    tooltip-text: _("Open Folder");
                    action-name: "assets.open-folder";

                    styles [
                      "flat",
                    ]
                  }

                  // Without files, the row in their place adds them.
                  Button add_assets_button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Add Files");
                    action-name: "assets.add";

                    styles [
                      "flat",
                    ]
                  }
                };

                // Files dropped onto it are added.
                Stack assets_stack {
                  vhomogeneous: false;

                  StackPage {
                    name: "list";

                    child: FlowBox assets_grid {
                      valign: start;
                      homogeneous: true;
                      selection-mode: none;
                      max-children-per-line: 8;
                      column-spacing: 12;
                      row-spacing: 18;
                    };
                  }

                  StackPage {
                    name: "empty";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ButtonRow {
                        title: _("_Add Files…");
                        use-underline: true;
                        start-icon-name: "list-add-symbolic";
                        action-name: "assets.add";
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }

                  StackPage {
                    name: "error";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ActionRow assets_error_row {
                        title: _("Cannot Read Files");

                        [prefix]
                        Image {
                          icon-name: "dialog-error-symbolic";
                        }
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }

                  styles [
                    "assets-drop",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Timeline");

                Box {
                  orientation: vertical;
                  spacing: 18;

                  ListBox timeline_list {
                    selection-mode: none;

                    [placeholder]
                    Label {
                      label: _("Blocks of this project in the day view show up here");
                      wrap: true;
                      justify: center;
                      margin-top: 18;
                      margin-bottom: 18;
                      margin-start: 12;
                      margin-end: 12;

                      styles [
                        "dim-label",
                      ]
                    }

                    styles [
                      "boxed-list",
                    ]
                  }

                  Button more_button {
                    label: _("_Load More");
                    use-underline: true;
                    halign: center;
                    visible: false;

                    styles [
                      "pill",
                    ]
                  }
                }
              }
            };
          };
        };
      }

      Adw.ViewStackPage git_tab {
        name: "git";
        title: _("Git");
        visible: false;

        child: $BitLogGitPage git_page {};
      }
    };
  };
}
