using Gtk 4.0;
using Adw 1;

template $BitLogProjectView: Adw.NavigationPage {
  tag: "project";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [end]
      Button edit_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Edit Project");
        action-name: "projects.edit";
      }
    }

    [top]
    Adw.InlineViewSwitcher switcher {
      stack: view_stack;
      halign: center;
      margin-bottom: 6;
      visible: false;
    }

    content: Adw.ViewStack view_stack {
      Adw.ViewStackPage {
        name: "project";
        title: _("Project");

        child: ScrolledWindow scrolled {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 900;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Box {
              orientation: vertical;
              // The note cards expand; the sections stay together at the top.
              valign: start;
              spacing: 24;

              Adw.PreferencesGroup {
                title: _("Time");

                Adw.ActionRow total_row {
                  title: _("Total");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow recent_row {
                  title: _("Recently");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow span_row {
                  title: _("First and Last Day");

                  styles [
                    "property",
                  ]
                }

                Adw.ActionRow longest_row {
                  title: _("Longest Block");

                  [suffix]
                  Image {
                    icon-name: "go-next-symbolic";
                  }

                  styles [
                    "property",
                  ]
                }
              }

              Adw.PreferencesGroup {
                title: _("Activity");
                description: _("Time spent per day in the last 30 days");

                $BitLogHeatmap heatmap {
                  cell-size: 18;
                  single-row: true;
                  halign: start;
                }
              }

              Adw.PreferencesGroup {
                title: _("Notes");

                // Without notes, the row in their place adds one.
                header-suffix: Button new_note_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New Note");
                  action-name: "notes.new";
                  valign: center;

                  styles [
                    "flat",
                  ]
                };

                Stack notes_stack {
                  vhomogeneous: false;

                  StackPage {
                    name: "list";

                    child: FlowBox notes_grid {
                      valign: start;
                      homogeneous: true;
                      selection-mode: none;
                      max-children-per-line: 8;
                      column-spacing: 12;
                      row-spacing: 18;
                    };
                  }

                  StackPage {
                    name: "empty";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ButtonRow empty_new_note_button {
                        title: _("_New Note");
                        use-underline: true;
                        start-icon-name: "list-add-symbolic";
                        action-name: "notes.new";
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }

                  StackPage {
                    name: "error";

                    child: ListBox {
                      valign: start;
                      selection-mode: none;

                      Adw.ActionRow notes_error_row {
                        title: _("Cannot Read Notes");

                        [prefix]
                        Image {
                          icon-name: "dialog-error-symbolic";
                        }
                      }

                      styles [
                        "boxed-list",
                      ]
                    };
                  }
                }
              }

              Adw.PreferencesGroup {
                title: _("Timeline");

                Box {
                  orientation: vertical;
                  spacing: 18;

                  ListBox timeline_list {
                    selection-mode: none;

                    [placeholder]
                    Label {
                      label: _("Blocks of this project in the day view show up here");
                      wrap: true;
                      justify: center;
                      margin-top: 18;
                      margin-bottom: 18;
                      margin-start: 12;
                      margin-end: 12;

                      styles [
                        "dim-label",
                      ]
                    }

                    styles [
                      "boxed-list",
                    ]
                  }

                  Button more_button {
                    label: _("_Load More");
                    use-underline: true;
                    halign: center;
                    visible: false;

                    styles [
                      "pill",
                    ]
                  }
                }
              }
            };
          };
        };
      }

      Adw.ViewStackPage git_page {
        name: "git";
        title: _("Git");
        visible: false;

        child: Box {
          orientation: vertical;

          Adw.Clamp {
            margin-top: 24;
            margin-start: 12;
            margin-end: 12;

            child: DropDown branch_dropdown {
              halign: start;
              tooltip-text: _("Branch");
              enable-search: true;
              search-match-mode: substring;
              expression: expr item as <StringObject>.string;
              visible: false;
            };
          }

          Stack commits_stack {
            vexpand: true;

            StackPage {
              name: "list";

              child: ScrolledWindow {
                hscrollbar-policy: never;

                child: Adw.Clamp {
                  margin-top: 24;
                  margin-bottom: 24;
                  margin-start: 12;
                  margin-end: 12;

                  child: Box {
                    orientation: vertical;
                    spacing: 24;

                    Adw.PreferencesGroup status_group {
                      visible: false;

                      Adw.ActionRow upstream_row {
                        title: _("Upstream");
                        visible: false;

                        styles [
                          "property",
                        ]
                      }

                      Adw.ActionRow uncommitted_row {
                        title: _("Uncommitted Changes");
                        visible: false;

                        styles [
                          "property",
                        ]
                      }
                    }

                    Box commits_box {
                      orientation: vertical;
                      spacing: 24;
                    }

                    Button more_commits_button {
                      label: _("_Load More");
                      use-underline: true;
                      halign: center;
                      visible: false;

                      styles [
                        "pill",
                      ]
                    }
                  };
                };
              };
            }

            StackPage {
              name: "empty";

              child: Adw.StatusPage {
                icon-name: "document-open-recent-symbolic";
                title: _("No Commits");
                description: _("The branch has no commits yet");
              };
            }

            StackPage {
              name: "error";

              child: Adw.StatusPage commits_error_page {
                icon-name: "dialog-error-symbolic";
                title: _("Cannot Read Commits");
              };
            }
          }
        };
      }
    };
  };
}
