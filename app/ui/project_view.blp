using Gtk 4.0;
using Adw 1;

template $KnotbookProjectView: Adw.NavigationPage {
  tag: "project";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [start]
      Button new_note_button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("New Note");
        action-name: "notes.new";
      }

      [end]
      Button edit_button {
        icon-name: "document-edit-symbolic";
        tooltip-text: _("Edit Project");
        action-name: "projects.edit";
      }
    }

    [top]
    Adw.InlineViewSwitcher {
      stack: view_stack;
      halign: center;
      margin-bottom: 6;
    }

    content: Adw.ViewStack view_stack {
      Adw.ViewStackPage {
        name: "overview";
        title: _("Overview");

        child: Adw.PreferencesPage {
          Adw.PreferencesGroup {
            title: _("Time");

            Adw.ActionRow total_row {
              title: _("Total");

              styles [
                "property",
              ]
            }

            Adw.ActionRow week_row {
              title: _("This Week");

              styles [
                "property",
              ]
            }

            Adw.ActionRow month_row {
              title: _("This Month");

              styles [
                "property",
              ]
            }

            Adw.ActionRow share_row {
              title: _("Share of All Work This Month");

              styles [
                "property",
              ]
            }

            Adw.ActionRow days_row {
              title: _("Days Worked On");

              styles [
                "property",
              ]
            }

            Adw.ActionRow average_row {
              title: _("Average per Day Worked On");

              styles [
                "property",
              ]
            }

            Adw.ActionRow first_row {
              title: _("First Day");

              styles [
                "property",
              ]
            }

            Adw.ActionRow last_row {
              title: _("Last Day");

              styles [
                "property",
              ]
            }

            Adw.ActionRow longest_row {
              title: _("Longest Block");

              [suffix]
              Image {
                icon-name: "go-next-symbolic";
              }

              styles [
                "property",
              ]
            }
          }

          Adw.PreferencesGroup {
            title: _("Activity");
            description: _("Time spent per day in the last 12 months");

            ScrolledWindow {
              vscrollbar-policy: never;
              propagate-natural-height: true;

              child: $KnotbookHeatmap heatmap {
                halign: start;
                margin-bottom: 6;
              };
            }
          }
        };
      }

      Adw.ViewStackPage {
        name: "notes";
        title: _("Notes");

        child: Stack stack {
          StackPage {
            name: "list";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                maximum-size: 1200;
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;

                child: FlowBox notes_grid {
                  valign: start;
                  homogeneous: true;
                  selection-mode: none;
                  max-children-per-line: 8;
                  column-spacing: 12;
                  row-spacing: 18;
                };
              };
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "text-x-generic-symbolic";
              title: _("No Notes");
              description: _("Notes keep what you know about a project, in Markdown");

              child: Button empty_new_note_button {
                label: _("_New Note");
                use-underline: true;
                halign: center;
                action-name: "notes.new";

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          }

          StackPage {
            name: "error";

            child: Adw.StatusPage error_page {
              icon-name: "dialog-error-symbolic";
              title: _("Cannot Read Notes");
            };
          }
        };
      }

      Adw.ViewStackPage {
        name: "timeline";
        title: _("Timeline");

        child: Stack timeline_stack {
          StackPage {
            name: "list";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;

                child: Box {
                  orientation: vertical;
                  spacing: 18;

                  ListBox timeline_list {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]
                  }

                  Button more_button {
                    label: _("_Load More");
                    use-underline: true;
                    halign: center;
                    visible: false;

                    styles [
                      "pill",
                    ]
                  }
                };
              };
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "x-office-calendar-symbolic";
              title: _("No Blocks");
              description: _("Blocks of this project in the day view show up here");
            };
          }
        };
      }

      Adw.ViewStackPage git_page {
        name: "git";
        title: _("Git");
        visible: false;

        child: Stack commits_stack {
          StackPage {
            name: "list";

            child: ScrolledWindow {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;

                child: Box {
                  orientation: vertical;
                  spacing: 24;

                  Box commits_box {
                    orientation: vertical;
                    spacing: 24;
                  }

                  Button more_commits_button {
                    label: _("_Load More");
                    use-underline: true;
                    halign: center;
                    visible: false;

                    styles [
                      "pill",
                    ]
                  }
                };
              };
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "document-open-recent-symbolic";
              title: _("No Commits");
              description: _("The current branch of the repository has no commits yet");
            };
          }

          StackPage {
            name: "error";

            child: Adw.StatusPage commits_error_page {
              icon-name: "dialog-error-symbolic";
              title: _("Cannot Read Commits");
            };
          }
        };
      }
    };
  };
}
