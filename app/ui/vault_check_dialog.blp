using Gtk 4.0;
using Adw 1;

template $BitLogVaultCheckDialog: Adw.Dialog {
  title: _("Check Vault");
  content-width: 600;
  content-height: 640;

  child: Adw.NavigationView navigation {
    Adw.NavigationPage {
      title: _("Check Vault");
      tag: "overview";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          Button check_button {
            icon-name: "view-refresh-symbolic";
            tooltip-text: _("Check Again");
          }
        }

        content: Stack stack {
          transition-type: crossfade;

          StackPage {
            name: "checking";

            child: Adw.Spinner {
              halign: center;
              valign: center;
              width-request: 32;
              height-request: 32;
            };
          }

          StackPage {
            name: "error";

            child: Adw.StatusPage error_page {
              icon-name: "dialog-error-symbolic";
              title: _("Cannot Check Vault");
            };
          }

          StackPage {
            name: "overview";

            child: Adw.PreferencesPage overview {
              Adw.PreferencesGroup sync_group {
                title: _("Sync");
                description: _("Shown in the sidebar as soon as they occur.");
              }

              Adw.PreferencesGroup severe_group {
                title: _("Severe");
                description: _("Reported when the vault is opened.");
              }

              Adw.PreferencesGroup other_group {
                title: _("Other");
                description: _("Only shown here.");
              }
            };
          }
        };
      };
    }
  };
}
