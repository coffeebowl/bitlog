using Gtk 4.0;
using Adw 1;

template $KnotbookConflictDialog: Adw.Dialog {
  title: _("Note Changed Elsewhere");
  content-width: 900;
  content-height: 600;
  width-request: 360;
  height-request: 360;
  // A version has to be chosen, or typed text could get lost.
  can-close: false;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      versions.orientation: vertical;
    }
  }

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;
    }

    content: Box {
      orientation: vertical;
      spacing: 12;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 12;

      Label message {
        wrap: true;
        xalign: 0;
      }

      Box versions {
        spacing: 12;
        homogeneous: true;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 6;

          Label {
            label: _("Your Version");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            child: $KnotbookMarkdownView mine {
              full: true;
              top-margin: 12;
              bottom-margin: 12;
              left-margin: 12;
              right-margin: 12;
            };

            styles [
              "card",
            ]
          }

          Button keep_mine {
            label: _("Keep _Your Version");
            use-underline: true;

            styles [
              "suggested-action",
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 6;

          Label {
            label: _("Other Version");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            child: $KnotbookMarkdownView theirs {
              full: true;
              top-margin: 12;
              bottom-margin: 12;
              left-margin: 12;
              right-margin: 12;
            };

            styles [
              "card",
            ]
          }

          Button keep_theirs {
            label: _("Keep _Other Version");
            use-underline: true;
          }
        }
      }
    };
  };
}
