using Gtk 4.0;
using Adw 1;

template $BitLogReportsPage: Adw.NavigationPage {
  title: _("Reports");

  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    Adw.Breakpoint {
      condition ("max-width: 520sp")

      setters {
        toolbar.reveal-bottom-bars: true;
        period_toggle.visible: false;
        export_button.visible: false;
      }
    }

    child: Adw.ToolbarView toolbar {
      reveal-bottom-bars: false;

      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {};

        [start]
        Box {
          styles [
            "linked",
          ]

          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Previous");
            action-name: "win.previous";
          }

          Button {
            icon-name: "go-next-symbolic";
            tooltip-text: _("Next");
            action-name: "win.next";
          }
        }

        [end]
        Button {
          label: _("_Today");
          use-underline: true;
          action-name: "win.today";
        }

        [end]
        MenuButton export_button {
          icon-name: "document-save-symbolic";
          tooltip-text: _("Export");
          menu-model: export_menu;
        }

        [end]
        Adw.ToggleGroup period_toggle {
          active-name: "month";

          Adw.Toggle {
            name: "week";
            label: _("Week");
          }

          Adw.Toggle {
            name: "month";
            label: _("Month");
          }

          Adw.Toggle {
            name: "year";
            label: _("Year");
          }
        }
      }

      // Takes what does not fit into the header bar of a narrow page.

      [bottom]
      ActionBar {
        [start]
        Adw.ToggleGroup {
          active-name: bind period_toggle.active-name bidirectional;

          Adw.Toggle {
            name: "week";
            label: _("Week");
          }

          Adw.Toggle {
            name: "month";
            label: _("Month");
          }

          Adw.Toggle {
            name: "year";
            label: _("Year");
          }
        }

        [end]
        MenuButton {
          icon-name: "document-save-symbolic";
          tooltip-text: _("Export");
          menu-model: export_menu;
        }
      }

      content: Adw.PreferencesPage {
        Adw.PreferencesGroup projects_group {
          title: _("Time per Project");

          header-suffix: Label total_label {
            valign: end;

            styles [
              "dim-label",
            ]
          };
        }

        Adw.PreferencesGroup categories_group {
          title: _("Time per Category");
          description: _("Project categories, breaks left out");

          $BitLogShareBar category_bar {
            margin-top: 12;
          }
        }

        Adw.PreferencesGroup {
          title: _("Activity");
          description: _("Working time per day, breaks left out");

          ScrolledWindow {
            vscrollbar-policy: never;
            propagate-natural-height: true;

            child: $BitLogHeatmap heatmap {
              halign: start;
              margin-bottom: 6;
            };
          }
        }
      };
    };
  };
}

menu export_menu {
  section {
    label: _("Export to the Exports Folder");

    item {
      label: _("_Blocks as CSV");
      action: "reports.export-blocks";
    }

    item {
      label: _("_Week Report as Markdown");
      action: "reports.export-week";
    }

    item {
      label: _("_Remote Work Days as CSV");
      action: "reports.export-remote";
    }
  }
}
