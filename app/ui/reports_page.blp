using Gtk 4.0;
using Adw 1;

template $KnotbookReportsPage: Adw.NavigationPage {
  title: _("Reports");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [start]
      Box {
        styles [
          "linked",
        ]

        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Previous");
          action-name: "win.previous";
        }

        Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next");
          action-name: "win.next";
        }
      }

      [end]
      Button {
        label: _("_Today");
        use-underline: true;
        action-name: "win.today";
      }

      [end]
      Adw.ToggleGroup period_toggle {
        active-name: "month";

        Adw.Toggle {
          name: "week";
          label: _("Week");
        }

        Adw.Toggle {
          name: "month";
          label: _("Month");
        }

        Adw.Toggle {
          name: "year";
          label: _("Year");
        }
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup projects_group {
        title: _("Time per Project");

        header-suffix: Label total_label {
          valign: end;

          styles [
            "dim-label",
          ]
        };
      }

      Adw.PreferencesGroup categories_group {
        title: _("Time per Category");
        description: _("Project categories, breaks left out");

        $KnotbookShareBar category_bar {
          margin-top: 12;
        }
      }

      Adw.PreferencesGroup year_group {
        description: _("Working time per day, breaks left out");

        ScrolledWindow {
          vscrollbar-policy: never;
          propagate-natural-height: true;

          child: $KnotbookHeatmap heatmap {
            halign: start;
            margin-bottom: 6;
          };
        }
      }
    };
  };
}
