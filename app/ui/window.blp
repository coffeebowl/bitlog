using Gtk 4.0;
using Adw 1;

template $BitLogWindow: Adw.ApplicationWindow {
  title: _("BitLog");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Stack stack {
      StackPage {
        name: "welcome";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton welcome_menu_button {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              primary: true;
              tooltip-text: _("Main Menu");
            }
          }

          content: Adw.StatusPage {
            icon-name: "dev.bitlog.BitLog";
            title: _("Welcome to BitLog");
            description: _("Open a vault, the folder that holds your log, or start a new one");

            child: Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Button {
                label: _("_Open Vault…");
                use-underline: true;
                action-name: "win.open-vault";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Button {
                label: _("_New Vault…");
                use-underline: true;
                action-name: "win.new-vault";

                styles [
                  "pill",
                ]
              }
            };
          };
        };
      }

      StackPage {
        name: "vault";

        child: Adw.NavigationSplitView split_view {
          sidebar: Adw.NavigationPage sidebar_page {
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                Button {
                  icon-name: "edit-find-symbolic";
                  action-name: "win.search";
                  tooltip-text: _("Search");
                }

                [end]
                MenuButton vault_menu_button {
                  icon-name: "open-menu-symbolic";
                  menu-model: primary_menu;
                  primary: true;
                  tooltip-text: _("Main Menu");
                }
              }

              [top]
              Adw.Banner conflict_banner {
                button-label: _("_Resolve");
              }

              content: Adw.Sidebar sidebar {
                Adw.SidebarSection pages_section {}

                Adw.SidebarSection projects_section {}
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      custom: "style-switcher";
    }
  }

  section {
    item {
      label: _("_Open Vault…");
      action: "win.open-vault";
    }

    item {
      label: _("_New Vault…");
      action: "win.new-vault";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_Check Vault…");
      action: "win.check-vault";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About BitLog");
      action: "app.about";
    }
  }
}
