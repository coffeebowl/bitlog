using Gtk 4.0;
using Adw 1;

template $KnotbookWindow: Adw.ApplicationWindow {
  title: _("Knotbook");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Stack stack {
      StackPage {
        name: "welcome";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            MenuButton welcome_menu_button {
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
              primary: true;
              tooltip-text: _("Main Menu");
            }
          }

          content: Adw.StatusPage {
            icon-name: "dev.knotbook.Knotbook";
            title: _("Welcome to Knotbook");
            description: _("Open a vault, the folder that holds your log, or start a new one");

            child: Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Button {
                label: _("_Open Vault…");
                use-underline: true;
                action-name: "win.open-vault";

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Button {
                label: _("_New Vault…");
                use-underline: true;
                action-name: "win.new-vault";

                styles [
                  "pill",
                ]
              }
            };
          };
        };
      }

      StackPage {
        name: "vault";

        child: Adw.NavigationSplitView split_view {
          sidebar: Adw.NavigationPage sidebar {
            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                Button {
                  icon-name: "edit-find-symbolic";
                  action-name: "win.search";
                  tooltip-text: _("Search");
                }

                [end]
                MenuButton vault_menu_button {
                  icon-name: "open-menu-symbolic";
                  menu-model: primary_menu;
                  primary: true;
                  tooltip-text: _("Main Menu");
                }
              }

              [top]
              Adw.Banner conflict_banner {
                button-label: _("_Resolve");
                action-name: "win.resolve-conflict";
              }

              content: ScrolledWindow {
                hscrollbar-policy: never;

                child: ListBox sidebar_list {
                  styles [
                    "navigation-sidebar",
                  ]

                  ListBoxRow today_row {
                    action-name: "win.show-today";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "weather-clear-symbolic";
                      }

                      Label {
                        label: _("Today");
                        xalign: 0;
                      }
                    };
                  }

                  ListBoxRow calendar_row {
                    action-name: "win.show-calendar";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "x-office-calendar-symbolic";
                      }

                      Label {
                        label: _("Calendar");
                        xalign: 0;
                      }
                    };
                  }

                  ListBoxRow tasks_row {
                    action-name: "win.show-tasks";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "checkbox-checked-symbolic";
                      }

                      Label {
                        label: _("Tasks");
                        xalign: 0;
                      }
                    };
                  }

                  ListBoxRow reports_row {
                    action-name: "win.show-reports";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "view-grid-symbolic";
                      }

                      Label {
                        label: _("Reports");
                        xalign: 0;
                      }
                    };
                  }

                  ListBoxRow notes_row {
                    action-name: "win.show-notes";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "text-x-generic-symbolic";
                      }

                      Label {
                        label: _("Notes");
                        xalign: 0;
                      }
                    };
                  }

                  ListBoxRow projects_row {
                    action-name: "win.show-projects";

                    child: Box {
                      spacing: 12;

                      Image {
                        icon-name: "folder-symbolic";
                      }

                      Label {
                        label: _("Projects");
                        xalign: 0;
                      }
                    };
                  }
                };
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      custom: "style-switcher";
    }
  }

  section {
    item {
      label: _("_Open Vault…");
      action: "win.open-vault";
    }

    item {
      label: _("_New Vault…");
      action: "win.new-vault";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_About Knotbook");
      action: "app.about";
    }
  }
}
