using Gtk 4.0;
using Adw 1;

template $KnotbookWindow: Adw.ApplicationWindow {
  title: _("Knotbook");
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Stack stack {
    StackPage {
      name: "welcome";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
            primary: true;
            tooltip-text: _("Main Menu");
          }
        }

        content: Adw.StatusPage {
          icon-name: "dev.knotbook.Knotbook";
          title: _("Welcome to Knotbook");
          description: _("Open a vault, the folder that holds your log");

          child: Button {
            label: _("_Open Vault…");
            use-underline: true;
            action-name: "win.open-vault";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      };
    }

    StackPage {
      name: "vault";

      child: Adw.NavigationSplitView split_view {
        sidebar: Adw.NavigationPage sidebar {
          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              [end]
              MenuButton {
                icon-name: "open-menu-symbolic";
                menu-model: primary_menu;
                primary: true;
                tooltip-text: _("Main Menu");
              }
            }

            content: ScrolledWindow {
              hscrollbar-policy: never;

              child: ListBox sidebar_list {
                styles [
                  "navigation-sidebar",
                ]

                ListBoxRow today_row {
                  action-name: "win.show-today";

                  child: Box {
                    spacing: 12;

                    Image {
                      icon-name: "weather-clear-symbolic";
                    }

                    Label {
                      label: _("Today");
                      xalign: 0;
                    }
                  };
                }

                ListBoxRow calendar_row {
                  action-name: "win.show-calendar";

                  child: Box {
                    spacing: 12;

                    Image {
                      icon-name: "x-office-calendar-symbolic";
                    }

                    Label {
                      label: _("Calendar");
                      xalign: 0;
                    }
                  };
                }
              };
            };
          };
        };
      };
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Open Vault…");
      action: "win.open-vault";
    }
  }

  section {
    item {
      label: _("_About Knotbook");
      action: "app.about";
    }
  }
}
