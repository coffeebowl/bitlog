using Gtk 4.0;
using Adw 1;

template $KnotbookWindow: Adw.ApplicationWindow {
  title: _("Knotbook");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }

    content: Stack stack {
      StackPage {
        name: "welcome";

        child: Adw.StatusPage {
          icon-name: "dev.knotbook.Knotbook";
          title: _("Welcome to Knotbook");
          description: _("Open a vault, the folder that holds your log");

          child: Button {
            label: _("_Open Vault…");
            use-underline: true;
            action-name: "win.open-vault";
            halign: center;

            styles [
              "pill",
              "suggested-action",
            ]
          };
        };
      }

      StackPage {
        name: "vault";

        child: Adw.StatusPage vault_page {
          icon-name: "folder-symbolic";
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Open Vault…");
      action: "win.open-vault";
    }
  }

  section {
    item {
      label: _("_About Knotbook");
      action: "app.about";
    }
  }
}
