using Gtk 4.0;
using Adw 1;

template $KnotbookWindow: Adw.ApplicationWindow {
  title: _("Knotbook");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }

    content: Adw.StatusPage {
      icon-name: "dev.knotbook.Knotbook";
      title: _("Knotbook");
      description: _("A daily dev log");
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_About Knotbook");
      action: "app.about";
    }
  }
}
