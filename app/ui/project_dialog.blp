using Gtk 4.0;
using Adw 1;

template $BitLogProjectDialog: Adw.Dialog {
  content-width: 420;
  default-widget: save_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
      }

      [end]
      Button save_button {
        use-underline: true;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow name_row {
          title: _("Name");
          activates-default: true;
        }
      }

      Adw.PreferencesGroup slug_group {
        description: _("Names the project's folder and is used in the command line.");

        Adw.EntryRow slug_row {
          title: _("ID");
          activates-default: true;
        }

        Label slug_hint {
          margin-top: 12;
          wrap: true;
          xalign: 0;
        }
      }

      Adw.PreferencesGroup {
        Adw.ActionRow {
          title: _("Color");
          activatable-widget: color_button;

          [suffix]
          ColorDialogButton color_button {
            valign: center;

            dialog: ColorDialog {
              with-alpha: false;
            };
          }
        }

        Adw.ComboRow status_row {
          title: _("Status");
        }
      }

      Adw.PreferencesGroup category_group {
        title: _("Category");
      }

      Adw.PreferencesGroup repo_group {
        title: _("Git Repositories");
        description: _("Only kept on this device");

        header-suffix: Button add_repo_button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Add Repository");
          valign: center;

          styles [
            "flat",
          ]
        };
      }
    };
  };
}
