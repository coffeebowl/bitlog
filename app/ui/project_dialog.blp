using Gtk 4.0;
using Adw 1;

template $BitLogProjectDialog: Adw.Dialog {
  content-width: 420;
  default-widget: save_button;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
      }

      [end]
      Button save_button {
        use-underline: true;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.EntryRow name_row {
          title: _("Name");
          activates-default: true;
        }
      }

      Adw.PreferencesGroup slug_group {
        description: _("Names the project's folder and is used in the command line.");

        Adw.EntryRow slug_row {
          title: _("ID");
          activates-default: true;
        }

        Label slug_hint {
          margin-top: 12;
          wrap: true;
          xalign: 0;
        }
      }

      Adw.PreferencesGroup {
        Adw.ActionRow {
          title: _("Color");
          activatable-widget: color_button;

          [suffix]
          ColorDialogButton color_button {
            valign: center;

            dialog: ColorDialog {
              with-alpha: false;
            };
          }
        }

        Adw.EntryRow category_row {
          title: _("Category");
          activates-default: true;
        }

        Adw.ComboRow status_row {
          title: _("Status");
        }
      }

      Adw.PreferencesGroup {
        title: _("Git Repository");
        description: _("Only kept on this device");

        Adw.ActionRow repo_row {
          title: _("Folder");
          subtitle-selectable: true;
          activatable-widget: choose_repo_button;

          [suffix]
          Button clear_repo_button {
            icon-name: "edit-clear-symbolic";
            tooltip-text: _("Remove Repository");
            valign: center;
            visible: false;

            styles [
              "flat",
            ]
          }

          [suffix]
          Button choose_repo_button {
            icon-name: "folder-open-symbolic";
            tooltip-text: _("Choose Folder");
            valign: center;

            styles [
              "flat",
            ]
          }
        }
      }
    };
  };
}
