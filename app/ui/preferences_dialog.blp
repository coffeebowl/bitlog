using Gtk 4.0;
using Adw 1;

template $BitLogPreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    description: _("Stored in the vault and shared by all devices that sync it");

    Adw.PreferencesGroup {
      Adw.EntryRow name_row {
        title: _("Name");
        show-apply-button: true;
      }

      Adw.ComboRow location_row {
        title: _("Default Location");
        subtitle: _("Set for new days");
      }

      Adw.ActionRow template_row {
        title: _("Note Template");
        activatable-widget: choose_template_button;

        [suffix]
        Button clear_template_button {
          icon-name: "edit-clear-symbolic";
          tooltip-text: _("Remove Template");
          valign: center;
          visible: false;

          styles [
            "flat",
          ]
        }

        [suffix]
        Button choose_template_button {
          icon-name: "document-open-symbolic";
          tooltip-text: _("Choose File");
          valign: center;

          styles [
            "flat",
          ]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Week");

      Adw.ComboRow first_day_row {
        title: _("First Day");
      }

      Adw.ActionRow {
        title: _("Workdays");

        [suffix]
        Box workdays_box {
          valign: center;

          styles [
            "linked",
          ]
        }
      }

      Adw.SpinRow target_hours_row {
        title: _("Target Hours");
        subtitle: _("Shared among the workdays in the week chart");
        digits: 1;

        adjustment: Adjustment {
          upper: 168;
          step-increment: 0.5;
          page-increment: 5;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Day View");

      Adw.ComboRow slot_row {
        title: _("Block Length");
        subtitle: _("Blocks snap to it when drawn or moved. Times can still be typed to the minute.");
      }

      Adw.ComboRow day_start_row {
        title: _("Day Starts");
      }

      Adw.ComboRow day_end_row {
        title: _("Day Ends");
      }
    }
  }
}
