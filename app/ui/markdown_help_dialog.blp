using Gtk 4.0;
using Adw 1;

template $BitLogMarkdownHelpDialog: Adw.Dialog {
  title: _("Markdown");
  content-width: 560;
  content-height: 640;
  width-request: 360;
  height-request: 294;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Notes, Days and Blocks");
        description: _("Headings and note links work differently depending on the text.");

        Adw.ActionRow {
          title: _("Project Notes");
          subtitle: _("Headings structure the note. [[note]] links a note of the same project, [[project/note]] one of another project.");
        }

        Adw.ActionRow {
          title: _("Day Notes and Block Texts");
          subtitle: _("Headings stay plain text, as they separate the blocks in the day file. Note links always name the project: [[project/note]].");
        }
      }

      Adw.PreferencesGroup {
        title: _("Text");
        description: _("Select text and type a marker such as * or ` to put it around the selection.");

        Adw.ActionRow {
          title: _("Heading");
          subtitle: _("Only in project notes");

          [suffix]
          Label {
            label: _("# Heading");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Bold");

          [suffix]
          Label {
            label: _("**bold**");

            styles [
              "monospace",
            ]
          }

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "<Control>b";
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Italic");

          [suffix]
          Label {
            label: _("*italic*");

            styles [
              "monospace",
            ]
          }

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "<Control>i";
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Code");

          [suffix]
          Label {
            label: _("`code`");

            styles [
              "monospace",
            ]
          }

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "<Control>e";
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Strikethrough");

          [suffix]
          Label {
            label: _("~~struck~~");

            styles [
              "monospace",
            ]
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Lists");

        Adw.ActionRow {
          title: _("Bullet List");

          [suffix]
          Label {
            label: _("- item");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Numbered List");
          subtitle: _("Renumbered after Enter and Tab");

          [suffix]
          Label {
            label: _("1. item");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Task");
          subtitle: _("Click the box to check it off");

          [suffix]
          Label {
            label: _("- [ ] task");

            styles [
              "monospace",
            ]
          }

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "<Control>l";
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Indent");
          subtitle: _("Shift+Tab moves the item back out");

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "Tab";
            valign: center;
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Links and Images");

        Adw.ActionRow {
          title: _("Link");
          subtitle: _("Or paste a web address over selected text");

          [suffix]
          Label {
            label: _("[text](https://…)");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Note Link");
          subtitle: _("Notes are suggested after [[");

          [suffix]
          Label {
            label: _("[[project/note]]");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Follow Link");
          subtitle: _("Or click it");

          [suffix]
          Adw.ShortcutLabel {
            accelerator: "<Control>Return";
            valign: center;
          }
        }

        Adw.ActionRow {
          title: _("Image");
          subtitle: _("Or paste or drop an image to copy it into the vault");

          [suffix]
          Label {
            label: _("![](photo.png)");

            styles [
              "monospace",
            ]
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Blocks");

        Adw.ActionRow {
          title: _("Quote");

          [suffix]
          Label {
            label: _("> quote");

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Callout");
          subtitle: _("Also TIP, IMPORTANT, WARNING and CAUTION");

          [suffix]
          Label {
            label: "> [!NOTE]";

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Code Block");
          subtitle: _("Name a language to highlight it, or mermaid for a diagram");

          [suffix]
          Label {
            label: "```rust";

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Table");
          subtitle: _("Enter adds a row");

          [suffix]
          Label {
            label: "| a | b |";

            styles [
              "monospace",
            ]
          }
        }

        Adw.ActionRow {
          title: _("Rule");

          [suffix]
          Label {
            label: "---";

            styles [
              "monospace",
            ]
          }
        }
      }
    };
  };
}
