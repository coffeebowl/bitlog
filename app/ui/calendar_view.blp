using Gtk 4.0;
using Adw 1;

template $KnotbookCalendarView: Adw.NavigationPage {
  title: _("Calendar");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [start]
      Box {
        styles [
          "linked",
        ]

        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Previous");
          action-name: "win.previous";
        }

        Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next");
          action-name: "win.next";
        }
      }

      [end]
      Button {
        label: _("_Today");
        use-underline: true;
        action-name: "win.today";
      }

      [end]
      Adw.ToggleGroup view_toggle {
        active-name: "month";

        Adw.Toggle {
          name: "month";
          label: _("Month");
        }

        Adw.Toggle {
          name: "week";
          label: _("Week");
        }
      }
    }

    content: Stack view_stack {
      StackPage {
        name: "month";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 900;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            child: Grid grid {
              column-homogeneous: true;
              row-spacing: 6;
              column-spacing: 6;
            };
          };
        };
      }

      StackPage {
        name: "week";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 900;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Box {
              orientation: vertical;
              spacing: 18;

              Label week_total {
                xalign: 0;
                wrap: true;

                styles [
                  "title-3",
                ]
              }

              $KnotbookWeekChart week_chart {}

              FlowBox legend {
                selection-mode: none;
                column-spacing: 18;
                max-children-per-line: 4;
              }
            };
          };
        };
      }
    };
  };
}
