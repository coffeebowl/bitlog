using Gtk 4.0;
using Adw 1;

template $KnotbookCalendarView: Adw.NavigationPage {
  title: _("Calendar");

  child: Adw.BreakpointBin breakpoint_bin {
    width-request: 360;
    height-request: 294;

    // The breakpoints come from wide to narrow, the last that matches wins.
    // Those without a name move the hours of the days of a month below
    // their number and narrow the margins.

    // Shortens the hours of the days of a month.
    Adw.Breakpoint short_breakpoint {
      condition ("max-width: 900sp")
    }

    Adw.Breakpoint {
      condition ("max-width: 640sp")

      setters {
        month_clamp.margin-start: 6;
        month_clamp.margin-end: 6;
      }
    }

    Adw.Breakpoint {
      condition ("max-width: 520sp")

      setters {
        toolbar.reveal-bottom-bars: true;
        view_toggle.visible: false;
        month_clamp.margin-start: 6;
        month_clamp.margin-end: 6;
      }
    }

    child: Adw.ToolbarView toolbar {
      reveal-bottom-bars: false;

      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {};

        [start]
        Box {
          styles [
            "linked",
          ]

          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Previous");
            action-name: "win.previous";
          }

          Button {
            icon-name: "go-next-symbolic";
            tooltip-text: _("Next");
            action-name: "win.next";
          }
        }

        [end]
        Button today_button {
          label: _("_Today");
          use-underline: true;
          action-name: "win.today";
        }

        [end]
        Adw.ToggleGroup view_toggle {
          active-name: "month";

          Adw.Toggle {
            name: "month";
            label: _("Month");
          }

          Adw.Toggle {
            name: "week";
            label: _("Week");
          }
        }
      }

      // Takes what does not fit into the header bar of a narrow page.

      [bottom]
      ActionBar {
        [center]
        Adw.ToggleGroup {
          active-name: bind view_toggle.active-name bidirectional;

          Adw.Toggle {
            name: "month";
            label: _("Month");
          }

          Adw.Toggle {
            name: "week";
            label: _("Week");
          }
        }
      }

      content: Stack view_stack {
        StackPage {
          name: "month";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp month_clamp {
              maximum-size: 1400;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              child: Box month {
                orientation: vertical;
                spacing: 6;
              };
            };
          };
        }

        StackPage {
          name: "week";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 900;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              child: Box {
                orientation: vertical;
                spacing: 18;

                Label week_total {
                  xalign: 0;
                  wrap: true;

                  styles [
                    "title-3",
                  ]
                }

                $KnotbookWeekChart week_chart {}

                FlowBox legend {
                  selection-mode: none;
                  column-spacing: 18;
                  max-children-per-line: 4;
                }
              };
            };
          };
        }
      };
    };
  };
}
