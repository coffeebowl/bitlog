using Gtk 4.0;
using Adw 1;

template $KnotbookDayView: Adw.NavigationPage {
  title: _("Day");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle window_title {};

      [start]
      Box {
        styles [
          "linked",
        ]

        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Previous Day");
          action-name: "win.previous-day";
        }

        Button {
          icon-name: "go-next-symbolic";
          tooltip-text: _("Next Day");
          action-name: "win.next-day";
        }
      }

      [end]
      Button {
        label: _("_Today");
        use-underline: true;
        action-name: "win.today";
      }
    }

    content: Stack stack {
      StackPage {
        name: "day";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            child: Box {
              homogeneous: true;
              spacing: 12;

              Box {
                orientation: vertical;

                Label {
                  label: _("Kind");
                  xalign: 0;

                  styles [
                    "caption-heading",
                    "dim-label",
                  ]
                }

                Label kind_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "title-4",
                  ]
                }
              }

              Box {
                orientation: vertical;

                Label {
                  label: _("Location");
                  xalign: 0;

                  styles [
                    "caption-heading",
                    "dim-label",
                  ]
                }

                Label location_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "title-4",
                  ]
                }
              }

              Box {
                orientation: vertical;

                Label {
                  label: _("Working Time");
                  xalign: 0;

                  styles [
                    "caption-heading",
                    "dim-label",
                  ]
                }

                Label working_time_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "title-4",
                  ]
                }

                Label work_hours_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "caption",
                    "dim-label",
                  ]
                }
              }
            };
          };
        };
      }

      StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "x-office-calendar-symbolic";
          title: _("Nothing Logged");
          description: _("There is no entry for this day");
        };
      }

      StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "dialog-warning-symbolic";
          title: _("Cannot Read Day");
        };
      }
    };
  };
}
