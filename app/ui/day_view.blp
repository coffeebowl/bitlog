using Gtk 4.0;
using Adw 1;

template $BitLogDayView: Adw.NavigationPage {
  title: _("Day");

  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    Adw.Breakpoint {
      condition ("max-width: 640sp")

      setters {
        split_view.collapsed: true;
      }
    }

    // The last matching breakpoint wins, so this one sets everything.
    Adw.Breakpoint {
      condition ("max-width: 520sp")

      setters {
        split_view.collapsed: true;
        toolbar.reveal-bottom-bars: true;
        new_block_button.visible: false;
        standup_button.visible: false;
      }
    }

    child: Adw.ToolbarView toolbar {
      reveal-bottom-bars: false;

      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {};

        [start]
        Box {
          styles [
            "linked",
          ]

          Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Previous Day");
            action-name: "win.previous";
          }

          Button {
            icon-name: "go-next-symbolic";
            tooltip-text: _("Next Day");
            action-name: "win.next";
          }
        }

        [start]
        Button new_block_button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("New Block");
          action-name: "day.new-block";
        }

        [end]
        MenuButton {
          icon-name: "view-more-symbolic";
          tooltip-text: _("Day Menu");
          menu-model: day_menu;
        }

        [end]
        Button {
          label: _("_Today");
          use-underline: true;
          action-name: "win.today";
        }

        [end]
        Button standup_button {
          icon-name: "system-users-symbolic";
          tooltip-text: _("Standup");
          action-name: "day.standup";
        }
      }

      // Takes what does not fit into the header bar of a narrow page.

      [bottom]
      ActionBar {
        [start]
        Button {
          action-name: "day.new-block";

          child: Adw.ButtonContent {
            icon-name: "list-add-symbolic";
            label: _("New Block");
          };
        }

        [end]
        Button {
          action-name: "day.standup";

          child: Adw.ButtonContent {
            icon-name: "system-users-symbolic";
            label: _("Standup");
          };
        }
      }

      content: Adw.OverlaySplitView split_view {
        sidebar-position: end;
        show-sidebar: false;
        min-sidebar-width: 260;
        // At most half the width, and as wide as dragged at its edge.
        sidebar-width-fraction: 0.5;

        content: Stack stack {
          StackPage {
            name: "day";

            child: ScrolledWindow day_scroll {
              hscrollbar-policy: never;

              child: Adw.Clamp {
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;

                child: Box {
                  orientation: vertical;
                  spacing: 24;

                  Box {
                    homogeneous: true;
                    spacing: 12;

                    MenuButton kind_button {
                      tooltip-text: _("Change Kind of Day");

                      styles [
                        "flat",
                      ]

                      child: Box {
                        orientation: vertical;

                        Label {
                          label: _("Kind");
                          xalign: 0;

                          styles [
                            "caption-heading",
                            "dim-label",
                          ]
                        }

                        Label kind_label {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "title-4",
                          ]
                        }
                      };
                    }

                    MenuButton location_button {
                      tooltip-text: _("Change Location");

                      styles [
                        "flat",
                      ]

                      child: Box {
                        orientation: vertical;

                        Label {
                          label: _("Location");
                          xalign: 0;

                          styles [
                            "caption-heading",
                            "dim-label",
                          ]
                        }

                        Label location_label {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "title-4",
                          ]
                        }
                      };
                    }

                    MenuButton {
                      tooltip-text: _("Change Work Hours");

                      styles [
                        "flat",
                      ]

                      popover: Popover work_popover {
                        default-widget: set_work_button;

                        child: Box {
                          orientation: vertical;
                          spacing: 12;
                          margin-top: 6;
                          margin-bottom: 6;
                          margin-start: 6;
                          margin-end: 6;

                          Grid {
                            column-spacing: 12;
                            row-spacing: 6;

                            Label {
                              label: _("_Start");
                              use-underline: true;
                              mnemonic-widget: work_start;
                              xalign: 0;

                              layout {
                                column: 0;
                                row: 0;
                              }
                            }

                            SpinButton work_start {
                              adjustment: Adjustment {
                                upper: 1439;
                                page-increment: 60;
                              };

                              wrap: true;
                              activates-default: true;

                              layout {
                                column: 1;
                                row: 0;
                              }
                            }

                            Label {
                              label: _("_End");
                              use-underline: true;
                              mnemonic-widget: work_end;
                              xalign: 0;

                              layout {
                                column: 0;
                                row: 1;
                              }
                            }

                            SpinButton work_end {
                              adjustment: Adjustment {
                                upper: 1439;
                                page-increment: 60;
                              };

                              wrap: true;
                              activates-default: true;

                              layout {
                                column: 1;
                                row: 1;
                              }
                            }
                          }

                          Box {
                            homogeneous: true;
                            spacing: 6;

                            Button {
                              label: _("_Remove");
                              use-underline: true;
                              action-name: "day.remove-work-hours";
                            }

                            Button set_work_button {
                              label: _("_Set");
                              use-underline: true;
                              action-name: "day.set-work-hours";

                              styles [
                                "suggested-action",
                              ]
                            }
                          }
                        };
                      };

                      child: Box {
                        orientation: vertical;

                        Label {
                          label: _("Working Time");
                          xalign: 0;

                          styles [
                            "caption-heading",
                            "dim-label",
                          ]
                        }

                        Label working_time_label {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "title-4",
                          ]
                        }

                        Label work_hours_label {
                          xalign: 0;
                          ellipsize: end;

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      };
                    }
                  }

                  $BitLogMarkdownView note_view {
                    editable: true;
                    placeholder: _("Add a note · no headings");
                  }

                  $BitLogTaskListView tasks {}

                  $BitLogTimeline timeline {}
                };
              };
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "x-office-calendar-symbolic";
              title: _("Nothing Logged");
              description: _("There is no entry for this day");

              child: Box {
                orientation: vertical;
                spacing: 36;

                Button {
                  label: _("_Log Day");
                  use-underline: true;
                  halign: center;
                  action-name: "day.create";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                $BitLogTaskListView empty_tasks {}
              };
            };
          }

          StackPage {
            name: "error";

            child: Adw.StatusPage error_page {
              icon-name: "dialog-warning-symbolic";
              title: _("Cannot Read Day");
            };
          }
        };

        sidebar: Overlay {
          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Box {
              orientation: vertical;
              spacing: 6;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              Box {
                spacing: 6;

                Entry block_title {
                  hexpand: true;
                  truncate-multiline: true;

                  accessibility {
                    label: _("Title");
                  }

                  styles [
                    "flat",
                    "title-3",
                  ]
                }

                Button {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Delete Block");
                  valign: start;
                  action-name: "day.delete-block";

                  styles [
                    "flat",
                    "circular",
                  ]
                }

                Button {
                  icon-name: "window-close-symbolic";
                  tooltip-text: _("Close");
                  valign: start;
                  action-name: "day.close-block";

                  styles [
                    "flat",
                    "circular",
                  ]
                }
              }

              Box {
                spacing: 6;

                MenuButton block_time_button {
                  tooltip-text: _("Change Time");
                  always-show-arrow: true;

                  styles [
                    "flat",
                  ]

                  popover: Popover block_time_popover {
                    default-widget: set_block_time_button;

                    child: Box {
                      orientation: vertical;
                      spacing: 12;
                      margin-top: 6;
                      margin-bottom: 6;
                      margin-start: 6;
                      margin-end: 6;

                      Grid {
                        column-spacing: 12;
                        row-spacing: 6;

                        Label {
                          label: _("_Start");
                          use-underline: true;
                          mnemonic-widget: block_start;
                          xalign: 0;

                          layout {
                            column: 0;
                            row: 0;
                          }
                        }

                        SpinButton block_start {
                          adjustment: Adjustment {
                            upper: 1439;
                            page-increment: 60;
                          };

                          wrap: true;
                          activates-default: true;

                          layout {
                            column: 1;
                            row: 0;
                          }
                        }

                        Label {
                          label: _("_End");
                          use-underline: true;
                          mnemonic-widget: block_end;
                          xalign: 0;

                          layout {
                            column: 0;
                            row: 1;
                          }
                        }

                        SpinButton block_end {
                          adjustment: Adjustment {
                            upper: 1439;
                            page-increment: 60;
                          };

                          wrap: true;
                          activates-default: true;

                          layout {
                            column: 1;
                            row: 1;
                          }
                        }
                      }

                      Button set_block_time_button {
                        label: _("_Set");
                        use-underline: true;
                        action-name: "day.set-block-time";

                        styles [
                          "suggested-action",
                        ]
                      }
                    };
                  };
                }

                MenuButton block_project_button {
                  tooltip-text: _("Change Project");
                  always-show-arrow: true;

                  styles [
                    "flat",
                  ]

                  child: Label block_project_label {
                    use-markup: true;
                    ellipsize: end;
                  };
                }
              }

              $BitLogMarkdownView block_text {
                margin-top: 12;
                editable: true;
                placeholder: _("Add text · no headings");
              }
            };
          };

          [overlay]
          Box panel_handle {
            width-request: 6;
            halign: start;
          }
        };
      };
    };
  };
}

menu day_menu {
  section {
    item {
      label: _("_Delete Day…");
      action: "day.delete";
    }
  }
}
